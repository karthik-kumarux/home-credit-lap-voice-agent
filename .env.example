# Add your API keys and configuration here
# Do NOT commit the actual .env file

# Voice Platform API Key (e.g., Bland, Vapi, Twilio)
VOICE_PLATFORM_API_KEY=your_voice_platform_key_here

# Groq API Key (Since we are using Groq models)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Specific LLM Model ID on Groq
# Make sure this model exists on your specific Groq tier!
# Known to work on some tiers: openai/gpt-oss-120b, qwen/qwen3.8-27b
LLM_MODEL_ID=openai/gpt-oss-120b
